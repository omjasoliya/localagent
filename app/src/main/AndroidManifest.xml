<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No INTERNET permission. The model file is picked from local storage after the
      user downloads it once in Chrome (Gemma's license has to be accepted in a
      browser); the app itself never phones home, and every prompt stays on-device.
    -->
    <uses-feature android:name="android.hardware.vulkan.compute" android:required="false" />

    <!--
      Package visibility (Android 11+): without this, queryIntentActivities only sees a
      handful of apps instead of everything with a launcher icon.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalAgent">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
